DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/binance_trade?schema=public"
EXTERNAL_SIGNAL_DB_URL="postgresql://postgres:postgres@127.0.0.1:5434/external_signal?schema=public"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
FEATURE_TRADING_READ=true
MT5_BRIDGE_PORT="8765"
MT5_EXEC_BRIDGE_PORT="8766"
BINANCE_API_URL="https://api.binance.us"
BINANCE_WS_URL="wss://stream.binance.us:9443/stream"

# Khóa bảo mật (Cần tự cấu hình)
INGESTION_TOKEN="your_ingestion_token_here"
ENCRYPTION_KEY="your_encryption_key_here"
JWT_SECRET="your_jwt_secret_here"
AUTH_BOOTSTRAP_ADMIN_PASSWORD="your_admin_password_here"

# Cấu hình cảnh báo Telegram
ALERT_TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
ALERT_TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
