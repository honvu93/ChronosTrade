# MT5 Credentials
MT5_LOGIN=your_mt5_login_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=Exness-MT5Real36
# Neu dung terminal rieng, chi duong dan day du
# MT5_TERMINAL_PATH=C:\MT5\market-data-terminal\terminal64.exe

# API Connection — script tu dong thu tunnel truoc, loi thi dung LAN
API_URL=https://trade-api.your-domain.com
API_URL_FALLBACK=http://192.168.x.x:3001

# Ingestion token — phai trung voi INGESTION_TOKEN trong .env cua backend tren Mac
INGESTION_TOKEN=your_ingestion_token_here

# Broker timezone (Exness summer = GMT+3)
BROKER_TIMEZONE=Etc/GMT-3

# Fetch settings
LIVE_INTERVAL_SECONDS=10
LIVE_FETCH_BARS=3
HISTORICAL_DAYS=30
FETCH_WORKERS=4
RETRY_MAX=3
