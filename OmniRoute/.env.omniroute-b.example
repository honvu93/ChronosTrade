# OmniRoute instance B
# Copy to `.env.omniroute-b` and replace placeholder secrets if needed.
JWT_SECRET=replace-with-random-base64
API_KEY_SECRET=replace-with-random-hex
INITIAL_PASSWORD=ChangeMe-B-Now!
DATA_DIR=/app/data
STORAGE_DRIVER=sqlite
STORAGE_ENCRYPTION_KEY=replace-with-random-hex
STORAGE_ENCRYPTION_KEY_VERSION=v1
LOG_RETENTION_DAYS=90
SQLITE_MAX_SIZE_MB=2048
SQLITE_CLEAN_LEGACY_FILES=true
PORT=30130
NODE_ENV=production
INSTANCE_NAME=omniroute-b
MACHINE_ID_SALT=omniroute-b-salt
ENABLE_REQUEST_LOGS=false
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
BASE_URL=http://localhost:30130
NEXT_PUBLIC_BASE_URL=http://localhost:30130
ENABLE_SOCKS5_PROXY=true
NEXT_PUBLIC_ENABLE_SOCKS5_PROXY=true
LOG_TO_FILE=true

# Optional remote deployment OAuth overrides
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_OAUTH_CLIENT_SECRET=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_SECRET=
